# ============================================================
# RAG-ai-chat 环境变量示例
# ------------------------------------------------------------
# 1. 复制本文件为 `.env` 后填入你自己的值即可：  cp .env.example .env
# 2. `.env` 已被 .gitignore 忽略，不会进入版本库；本文件 `.env.example` 会提交，作为配置清单。
# 3. 所有形如 <...> 的都是需要你替换的占位符，请改成真实值。
# 4. 项目默认走「本地大模型」路线（数据不出本机），如需云端模型把 DEFAULT_LLM_PROVIDER 切到对应值。
# ============================================================

# ---------- 1. LLM 提供商选择 ----------
# 可选值: qwen / doubao / zhipu / local
# local = 模型跑在本地 8080 端口，知识库数据不出网
DEFAULT_LLM_PROVIDER=local

# ---------- 2. 本地大模型（llama.cpp / vLLM / Ollama，OpenAI 兼容接口）----------
LOCAL_MODEL_BASE_URL=http://localhost:8080/v1
LOCAL_MODEL_NAME=qwen2.5-7b
LOCAL_MODEL_API_KEY=EMPTY

# ---------- 3. 云端 LLM（按需启用，把上面 DEFAULT_LLM_PROVIDER 切到对应值即可）----------
# 通义千问
DASHSCOPE_API_KEY=<your-dashscope-key>
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-turbo
# 火山豆包
ARK_API_KEY=<your-ark-key>
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-1-5-lite-32k-250115
# 智谱 GLM
ZHIPU_API_KEY=<your-zhipu-key>
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.7-flash

# ---------- 4. 向量库 ----------
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./chroma_db
CHROMA_COLLECTION_NAME=default_collection

# ---------- 5. 嵌入模型（本地 bge-large-zh-v1.5）----------
HUGGINGFACEEMBEDDINGS_MODEL_NAME=BAAI/bge-large-zh-v1.5
HUGGINGFACEEMBEDDINGS_DEVICE=cpu
# 备选：OpenAI 云端 embedding（取消注释并配置后使用）
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_API_KEY=<your-openai-key>

# ---------- 6. 重排序模型（本地 bge-reranker-v2-m3）----------
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_MODEL_DEVICE=cpu

# ---------- 7. RAG 检索 ----------
ENABLE_HYDE=true
BASE_RECALL_TOK_K=20


# ---------- 8. 文件存储 ----------
FILE_STORAGE_PATH=./knowledge_files
UPLOAD_STAGING_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
MAX_UPLOAD_FILES=5
MAX_STORAGE_PER_USER_MB=500

# ---------- 9. MySQL ----------
MYSQL_USER=root
MYSQL_PASSWORD=<your-mysql-password>
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=rag_agent_db

# ---------- 10. JWT ----------
# 用 python -c "import secrets;print(secrets.token_hex(32))" 生成一个随机值
SECRET_KEY=<generate-a-random-secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- 11. Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 也可直接填完整 URL 覆盖上面各项：REDIS_URL=redis://:password@localhost:6379/0

# ---------- 12. HuggingFace 镜像（国内拉模型用）----------
HF_ENDPOINT=https://hf-mirror.com

# ---------- 13. 可选 / 评测开关（不填则走代码默认值，基础运行无需配置）----------
# 评测时切换 Agent 范式：react（默认） / fc / langgraph
AGENT_MODE=react
# 评测单用例超时（秒），默认 600
EVAL_CASE_TIMEOUT=600
# 评测断点续跑，默认 true；设 false 从头跑并清旧检查点
EVAL_RESUME=true
# 评测限定知识库 ID（逗号分隔），留空=全部；仅 run_eval.py 用
EVAL_KB_IDS=
# 关闭 LLM 前缀缓存（仅 local 生效），默认 true；设 false 关闭
LLM_PROMPT_CACHE=true
# 查询改写最大 token，默认 256
QUERY_REWRITE_MAX_TOKENS=256
# 嵌入 / 重排序设备，默认 cpu（等价于第 5/6 节的 HUGGINGFACEEMBEDDINGS_DEVICE / RERANK_MODEL_DEVICE）
EMBEDDING_DEVICE=cpu
RERANK_DEVICE=cpu
# LLM 提供商覆盖（run_eval 用），默认取第 1 节的 DEFAULT_LLM_PROVIDER
LLM_PROVIDER=local
